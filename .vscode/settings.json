{
    // This repo builds exclusively via `make` (see Makefile / README.md), NOT LaTeX Workshop's own build system --
    // different variants need different engines (pdflatex for Resume/CV, xelatex for cover letters) and the
    // Makefile also toggles secret_*.txt contact-info files around each build. Letting LaTeX Workshop auto-build
    // would use the wrong engine and could leave secret files in the wrong state.
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.view.pdf.viewer": "tab",

    // Matches the `vim: set textwidth=120 tabstop=4 softtabstop=4 expandtab smarttab ...` modeline present at the
    // top of every .tex file in this repo.
    "editor.rulers": [120],
    "[latex]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [120]
    },
    "[tex]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [120]
    },
    "[makefile]": {
        "editor.insertSpaces": false
    },
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // Hide LaTeX build artifacts (regenerated by `make`) from the explorer -- keep generated PDFs visible since
    // they're the actual output being reviewed.
    "files.exclude": {
        "**/*.aux": true,
        "**/*.fls": true,
        "**/*.fdb_latexmk": true,
        "**/*.synctex.gz": true,
        "**/*.log": true,
        "**/*.out": true
    },
    "search.exclude": {
        "**/*.aux": true,
        "**/*.fls": true,
        "**/*.fdb_latexmk": true,
        "**/*.synctex.gz": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.pdf": true
    },
    "files.watcherExclude": {
        "**/*.aux": true,
        "**/*.fls": true,
        "**/*.fdb_latexmk": true,
        "**/*.synctex.gz": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.pdf": true
    },

    // Reduce false-positive spell-check flags on this repo's proper nouns and domain-specific terms.
    "cSpell.words": [
      "agap2",
      "Airwallex",
      "aitools",
      "Avenir",
